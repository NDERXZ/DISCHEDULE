# -----------------------------------------------------------------------------
# Dischedule - Application Configuration
# -----------------------------------------------------------------------------

# Application
APP_NAME="Dischedule"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_KEY="base64:c29tZXJhbmRvbXNlY3JldGtleWZvcmRpc2NoZWR1bGUyMDI2"
APP_TIMEZONE="UTC"
APP_LOCALE="en"
MAINTENANCE_MODE=false

# Database Configuration (MySQL 8.0+ / MariaDB 10.4+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dischedule
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Security
SESSION_LIFETIME=86400
SESSION_COOKIE_NAME=dischedule_session
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Mail Configuration
# Drivers: 'mail' (PHP built-in mail) or 'smtp' (Socket SMTP client)
MAIL_DRIVER=mail
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@dischedule.local"
MAIL_FROM_NAME="Dischedule Notifications"

# Discord Integration
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:8000/auth/discord/callback"
DISCORD_BOT_TOKEN=""
DISCORD_GLOBAL_WEBHOOK_URL=""
DISCORD_BOT_NAME="Dischedule Bot"
DISCORD_AVATAR_URL="https://raw.githubusercontent.com/discord/discord-api-docs/master/assets/discord-logo-color.png"

# Security & Limits
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY=900
RATE_LIMIT_API_MAX=100
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,txt,ics,csv"
